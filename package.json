{
  "name": "iadonkey",
  "version": "2.1.6",
  "description": "IADonkey Launcher",
  "author": "MagicWare",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "compile": "tsc && vite build && node -e \"const fs = require('fs'); fs.cpSync('electron/assets', 'dist-electron/assets', {recursive: true, force: true});\"",
    "build": "npm run compile",
    "build:exe": "npm run compile && electron-builder",
    "build:dir": "npm run compile && electron-builder --dir",
    "dist": "npm run compile && electron-builder",
    "release": "node ./scripts/release.mjs",
    "start": "electron ."
  },
  "build": {
    "appId": "com.iadonkey.launcher",
    "productName": "IADonkey",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "electron/assets"
    ],
    "asarUnpack": [
      "electron/assets/**",
      "**/color-picker.exe",
      "**/paste-helper.exe"
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}.${ext}",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
